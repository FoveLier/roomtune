<UserControl x:Class="RoomTune.Desktop.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="项目" Style="{StaticResource PageTitle}" />
            <TextBlock Text="每套房间、音箱与听音位是一个独立档案；所有数据保存在 F:\RoomTuneData。" Style="{StaticResource PageSub}" />
            <WrapPanel Margin="0,16,0,0">
                <TextBox x:Name="NewName" Width="190" Text="新房间" Margin="0,0,8,8" />
                <Button Content="新建项目" Style="{StaticResource PrimaryButton}" Click="New_Click" Margin="0,0,8,8" />
                <Button Content="打开" Click="Open_Click" Margin="0,0,8,8" />
                <Button Content="删除" Click="Delete_Click" Margin="0,0,8,8" />
                <Button Content="导入同步码" Click="ImportSync_Click" Margin="0,0,8,8" />
                <Button Content="打开数据目录" Click="OpenFolder_Click" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="0.75*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="本机项目" Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="ProjectList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ProjectList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,8">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdatedAt}" Style="{StaticResource SmallText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="项目摘要" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DetailsText" Text="请选择一个项目。" TextWrapping="Wrap" LineHeight="22" />
                    <Separator Margin="0,16,0,12" />
                    <TextBlock Text="数据位置" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="DataFolderText" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="同步方式" Style="{StaticResource LabelText}" Margin="0,14,0,0" />
                    <TextBlock Text="导出同步码 → 手机端粘贴导入；手机导出后可在 PC 端导入为新项目。" Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
