<UserControl x:Class="RoomTune.Desktop.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RoomTune.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="房间与系统" Style="{StaticResource PageTitle}" />
                <TextBlock Text="先录入真实尺寸、材质和音箱参数；右侧平面图可拖动音箱和听音位。" Style="{StaticResource PageSub}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="560" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="房间档案" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="项目名称" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="NameBox" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="长 (m)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="LengthBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="宽 (m)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="WidthBox" Grid.Column="3" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="4" Text="高 (m)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="HeightBox" Grid.Column="5" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="形状" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="ShapeBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="家具量" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="FurnitureBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="地面" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="FloorBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="墙面" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="WallBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="吊顶" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="CeilingBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="窗占比 %" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="WindowBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="听音位 X (m)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ListenerXBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="听音位 Y (m)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ListenerYBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="音箱与动态范围" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="布局" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="LayoutBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="目标用途" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="TargetUseBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="型号" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ModelBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="目标曲线" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="TargetCurveBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="音箱总数" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="SpeakerCountBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="低音炮数" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="SubCountBox" Grid.Column="3" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="低频 Hz" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="LowFreqBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="高频 Hz" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="HighFreqBox" Grid.Column="3" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="4" Text="灵敏度 (dB)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="SensitivityBox" Grid.Column="5" Margin="4,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="最大声压 (dB)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="MaxSplBox" Grid.Column="1" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="动态范围 (dB)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="DynamicRangeBox" Grid.Column="3" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="4" Text="听音音量 (dB)" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ListeningLevelBox" Grid.Column="5" Margin="4,0,0,0" />
                            </Grid>
                            <TextBlock Text="说明：低频下潜/高频延伸与最大声压用于分频、EQ headroom 和动态余量提示；没有实测时只作起点。" Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <WrapPanel>
                        <Button Content="保存并更新分析" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,0,8,8" />
                        <Button Content="按布局重置音箱" Click="ResetLayout_Click" Margin="0,0,8,8" />
                        <Button Content="应用对称摆位" Click="Balanced_Click" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource SmallText}" Margin="0,2,0,12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="房间平面图" Style="{StaticResource SectionTitle}" />
                            <controls:RoomPlanControl x:Name="PlanControl" Height="520" />
                            <TextBlock Text="拖拽蓝色音箱、橙色低音炮或深青色听音位；修改后点击保存。" Style="{StaticResource SmallText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
