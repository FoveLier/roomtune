<UserControl x:Class="RoomTune.Desktop.Views.MeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RoomTune.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="测量" Style="{StaticResource PageTitle}" />
            <TextBlock Text="导入 REW 导出的“频率, dB”CSV；用于把“估算”升级为含实测参考。PC 端不直接采集麦克风。" Style="{StaticResource PageSub}" />
            <WrapPanel Margin="0,16,0,10">
                <Button Content="导入 REW CSV" Style="{StaticResource PrimaryButton}" Click="Import_Click" Margin="0,0,8,8" />
                <Button Content="清除测量" Click="Clear_Click" Margin="0,0,8,8" />
            </WrapPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="实测频响" Style="{StaticResource SectionTitle}" />
                    <controls:ResponseChartControl x:Name="ResponseChart" Height="380" />
                    <TextBlock x:Name="MetaText" Style="{StaticResource SmallText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="支持的 CSV 格式" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="REW 的 Export → Measurement 导出通常包含 Frequency (Hz), SPL (dB) 两列；逗号、制表符、分号或空格分隔均可。程序取每行前两列数字，排序后绘制对数频率轴。" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="注意：单点测量只在该位置有效；多座位差异请分别导入/记录，参数卡仍需复核。" Style="{StaticResource SmallText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource SmallText}" Margin="0,10,0,16" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
