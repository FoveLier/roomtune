<Window x:Class="RoomTune.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomTune 声居 · 数字房间声学校正"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,26,20,18">
                    <TextBlock Text="RoomTune" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="声居 · 房间声学校正" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                    <TextBlock Text="PC 工作台" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16">
                    <Button Content="同步码" Style="{StaticResource SecondaryButton}" Click="SyncButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                    <TextBlock x:Name="DataPathText" Text="数据目录：F:\RoomTuneData" Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged"
                         Margin="12,0">
                    <ListBoxItem Content="项目" />
                    <ListBoxItem Content="房间与系统" />
                    <ListBoxItem Content="声学分析" />
                    <ListBoxItem Content="校正方案" />
                    <ListBoxItem Content="测量" />
                    <ListBoxItem Content="报告" />
                    <ListBoxItem Content="设置" />
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="26,20,26,24" />
    </Grid>
</Window>
